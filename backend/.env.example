# Database Connection URL (for PostgreSQL/Neon, use the pooled connection string ending in -pooler)
DATABASE_URL=sqlite:///./expense_tracker.db

# JWT Secret Key and Settings
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# Database Tables Auto-creation (true/false)
AUTO_CREATE_TABLES=true
